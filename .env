# ========================================================
# CampusConnect Server Environment Configuration
# ========================================================

# Server Port
PORT=5000

# Environment Mode (development | production | test)
NODE_ENV=development

# MongoDB Connection URI
# Local MongoDB: mongodb://localhost:27017/campus_connect
# MongoDB Atlas example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/campus_connect?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/campus_connect

# External APIs Configuration
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1
CAMPUS_LATITUDE=28.6139
CAMPUS_LONGITUDE=77.2090
CAMPUS_CITY="New Delhi"

# Enable Local JSON File Storage Sync
ENABLE_JSON_FALLBACK=true
